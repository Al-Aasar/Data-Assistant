# Google Gemini API Key (Used by Knowledge Agent, Analysis Agent, and Result Agent)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative alias supported:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Used by Guardrails Agent for fast guardrail classification)
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=data-assistant